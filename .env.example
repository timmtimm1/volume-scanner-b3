# Copie para .env e preencha. NUNCA commite o .env.
# Valores abaixo sao placeholders, nao credenciais.

# Desenvolvimento: o Postgres local do docker-compose.yml.
# Deixe esta linha ativa. A suite roda em ~20s contra ele, e cria um banco
# isolado `<db>_pytest` ao lado -- que voce nao quer criando dentro do Neon.
SCANNER_DATABASE_URL=postgresql+psycopg://scanner:scanner@localhost:5432/scanner

# Producao: o Neon. Vive nos GitHub Secrets e nas variaveis da Vercel.
# Aqui fica comentada; mova o `#` so quando for mexer no banco de producao
# de proposito, e lembre de desfazer depois.
# SCANNER_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

SCANNER_TELEGRAM_BOT_TOKEN=
SCANNER_TELEGRAM_CHAT_ID=

# URL publica do site, usada no link do alerta.
SCANNER_WEB_BASE_URL=http://localhost:3000
